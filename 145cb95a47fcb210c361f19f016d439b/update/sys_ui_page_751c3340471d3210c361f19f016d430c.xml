        <endpoint>x_587457_pear_Applicative Access Preview - Dynamic v3.do</endpoint>
        <html>&lt;j:jelly xmlns:j="jelly:core" xmlns:g="glide"&gt;&#13;
  &lt;div id="pear-aa-container"&gt;&#13;
    &lt;h4&gt;Assignable Applicative Access (Dynamic Preview by Business Profiles and Projects) - v3&lt;/h4&gt;&#13;
    &lt;button id="pear-aa-refresh" type="button"&gt;Refresh&lt;/button&gt;&#13;
    &lt;div id="pear-aa-loading" style="display:none;"&gt;Loading...&lt;/div&gt;&#13;
    &lt;table id="pear-aa-table" class="table table-bordered table-striped table-sm" style="display:none;"&gt;&#13;
      &lt;thead&gt;&#13;
        &lt;tr&gt;&#13;
          &lt;th&gt;Business part&lt;/th&gt;&#13;
          &lt;th&gt;App access ID&lt;/th&gt;&#13;
          &lt;th&gt;App access&lt;/th&gt;&#13;
          &lt;th&gt;Application&lt;/th&gt;&#13;
          &lt;th&gt;App access format&lt;/th&gt;&#13;
          &lt;th&gt;Technical role&lt;/th&gt;&#13;
          &lt;th&gt;Business unit&lt;/th&gt;&#13;
          &lt;th&gt;Organization&lt;/th&gt;&#13;
          &lt;th&gt;Project&lt;/th&gt;&#13;
          &lt;th&gt;Group&lt;/th&gt;&#13;
          &lt;th&gt;Company&lt;/th&gt;&#13;
        &lt;/tr&gt;&#13;
      &lt;/thead&gt;&#13;
      &lt;tbody id="pear-aa-body"&gt;&lt;/tbody&gt;&#13;
    &lt;/table&gt;&#13;
  &lt;/div&gt;&#13;
&#13;
  &lt;script&gt;&#13;
  //&lt;![CDATA[&#13;
    window.refreshAAPreview = function() {&#13;
      var loading = document.getElementById('pear-aa-loading');&#13;
      var table   = document.getElementById('pear-aa-table');&#13;
      var body    = document.getElementById('pear-aa-body');&#13;
&#13;
      var rowsJSON = '[]';&#13;
      try { rowsJSON = g_form.getValue('pear_mrvs_v3') || '[]'; } catch(e) {}&#13;
&#13;
      loading.style.display = 'block';&#13;
      table.style.display   = 'none';&#13;
      body.innerHTML = '';&#13;
&#13;
      var ga = new GlideAjax('x_587457_pear.PEAR_Utils3'); // se scoped: 'x_587457_pear.PEAR_PreviewAPI'&#13;
      ga.addParam('sysparm_name','getApplicativeAccessByBp_v3');&#13;
      ga.addParam('sysparm_rowsJson', rowsJSON);&#13;
      ga.getXMLAnswer(function(answer){&#13;
        loading.style.display = 'none';&#13;
        var data = [];&#13;
        try { data = JSON.parse(answer || '[]'); } catch(e) {}&#13;
        data.forEach(function(row){&#13;
          var tr = document.createElement('tr');&#13;
          ['business_part','number','label','app_id','app_access_format','technical_role','business_unit','organization','project','group','company'].forEach(function(f){&#13;
            var td = document.createElement('td');&#13;
            td.textContent = row[f] || '';&#13;
            tr.appendChild(td);&#13;
          });&#13;
          body.appendChild(tr);&#13;
        });&#13;
        table.style.display = 'table';&#13;
      });&#13;
    };&#13;
&#13;
    // primo render e bottone refresh&#13;
    addLoadEvent(function(){&#13;
      if (typeof window.refreshAAPreview === 'function') window.refreshAAPreview();&#13;
      var btn = document.getElementById('pear-aa-refresh');&#13;
      if (btn) btn.addEventListener('click', window.refreshAAPreview);&#13;
    });&#13;
  //]]&gt;&#13;
  &lt;/script&gt;&#13;
&lt;/j:jelly&gt;&#13;
</html>
