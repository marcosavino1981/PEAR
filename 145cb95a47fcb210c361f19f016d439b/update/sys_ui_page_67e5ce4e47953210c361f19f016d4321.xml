    <sys_ui_page action="INSERT_OR_UPDATE">
        <category>general</category>
        <client_script/>
        <description/>
        <direct>false</direct>
        <endpoint>x_587457_pear_License Preview.do</endpoint>
        <html>&lt;j:jelly xmlns:j="jelly:core" xmlns:g="glide"&gt;&#13;
  &lt;div id="pear-l-container"&gt;&#13;
    &lt;h4&gt;Assignable Licenses&lt;/h4&gt;&#13;
    &lt;button id="pear-l-refresh" type="button"&gt;RefreshLIC&lt;/button&gt;&#13;
    &lt;div id="pear-l-loading" style="display:none;"&gt;Loading...&lt;/div&gt;&#13;
    &lt;table id="pear-l-table" class="table table-bordered table-striped table-sm" style="display:none;"&gt;&#13;
      &lt;thead&gt;&#13;
        &lt;tr&gt;&#13;
          &lt;th&gt;License ID&lt;/th&gt;&#13;
          &lt;th&gt;Label&lt;/th&gt;&#13;
          &lt;th&gt;Application&lt;/th&gt;&#13;
          &lt;th&gt;Max number&lt;/th&gt;&#13;
        &lt;/tr&gt;&#13;
      &lt;/thead&gt;&#13;
      &lt;tbody id="pear-l-body"&gt;&lt;/tbody&gt;&#13;
    &lt;/table&gt;&#13;
  &lt;/div&gt;&#13;
&#13;
  &lt;script&gt;&#13;
  //&lt;![CDATA[&#13;
    window.refreshLICPreview = function() {&#13;
      var loading = document.getElementById('pear-l-loading');&#13;
      var table   = document.getElementById('pear-l-table');&#13;
      var body    = document.getElementById('pear-l-body');&#13;
&#13;
      var rowsJSON = '[]';&#13;
      try {&#13;
			rowsJSON = g_form.getValue('pear_mrvs_v3') || '[]'; &#13;
			requestedFor = g_form.getValue('requested_for') || '[]'; &#13;
		} catch(e) {}&#13;
&#13;
      loading.style.display = 'block';&#13;
      table.style.display   = 'none';&#13;
      body.innerHTML = '';&#13;
&#13;
      var ga = new GlideAjax('x_587457_pear.PEAR_Utils3');&#13;
      ga.addParam('sysparm_name','getLicenseByBp');&#13;
      ga.addParam('sysparm_requestedFor', requestedFor);&#13;
      ga.addParam('sysparm_rowsJson', rowsJSON);&#13;
      ga.getXMLAnswer(function(answer){&#13;
        loading.style.display = 'none';&#13;
        var data = [];&#13;
        try { data = JSON.parse(answer || '[]'); } catch(e) {}&#13;
        data.forEach(function(row){&#13;
          var tr = document.createElement('tr');&#13;
          ['number','label','application','max_number'].forEach(function(f){&#13;
            var td = document.createElement('td');&#13;
            td.textContent = row[f] || '';&#13;
            tr.appendChild(td);&#13;
          });&#13;
          body.appendChild(tr);&#13;
        });&#13;
        table.style.display = 'table';&#13;
      });&#13;
    };&#13;
&#13;
    // primo render e bottone refresh&#13;
    addLoadEvent(function(){&#13;
      if (typeof window.refreshLICPreview === 'function') window.refreshLICPreview();&#13;
      var btn = document.getElementById('pear-l-refresh');&#13;
      if (btn) btn.addEventListener('click', window.refreshLICPreview);&#13;
    });&#13;
  //]]&gt;&#13;
  &lt;/script&gt;&#13;
&lt;/j:jelly&gt;&#13;
</html>
