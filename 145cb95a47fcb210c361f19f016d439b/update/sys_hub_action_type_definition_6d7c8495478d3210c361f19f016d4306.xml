        <value>(function execute(inputs, outputs) {&#13;
&#13;
    var rowsJsonRitm = (inputs.ritm.variables.pear_mrvs + '') || '[]';&#13;
    var JsonPreview = new x_587457_pear.PEAR_PreviewAPI().getApplicativeAccessByBp(rowsJsonRitm);&#13;
&#13;
    var abp_sysId;&#13;
    var aaa_sysId;&#13;
    var pmng_user = new GlideRecord('x_587457_pear_pmng_user');&#13;
    pmng_user.get('uid',inputs.ritm.requested_for);&#13;
    var bp = new GlideRecord('x_587457_pear_business_profile');&#13;
    var abp = new GlideRecord('x_587457_pear_assigned_business_profile');&#13;
	&#13;
	var p = new GlideRecord('x_587457_pear_prj_space');&#13;
	var ap = new GlideRecord('x_587457_pear_assigned_project_collab_space');&#13;
	&#13;
    var aa = new GlideRecord('x_587457_pear_applicative_access');&#13;
    var aaa = new GlideRecord('x_587457_pear_assigned_app_access');&#13;
    var aa_list = JSON.parse(JsonPreview);&#13;
    for(i=0; i&lt;aa_list.length; i++)&#13;
    {&#13;
        aa.get('number',aa_list[i].number); // Find applicative access&#13;
        bp.get('number',aa_list[i].business_profile_id); // Find Business profile&#13;
        p.get('number',aa_list[i].project_space_id); // Find project space&#13;
		&#13;
        var abpAlreadyAssigned = new GlideRecord('x_587457_pear_assigned_business_profile');&#13;
        abpAlreadyAssigned.addQuery('uid',pmng_user.sys_id);&#13;
        abpAlreadyAssigned.addQuery('business_profile_id',bp.sys_id);&#13;
        abpAlreadyAssigned.query();&#13;
        if(!abpAlreadyAssigned.next())&#13;
        {&#13;
			abp.initialize();&#13;
			gs.info('Business profile NOT already assigned ' + bp.label)&#13;
            abp.uid = pmng_user.sys_id;&#13;
            abp.assignment_date = new GlideDateTime();&#13;
            abp.business_profile_id = bp.sys_id;&#13;
            abp_sysId = abp.insert();&#13;
        }&#13;
		else&#13;
		{&#13;
			gs.info('Business profile already assigned ' + bp.label)&#13;
            abp_sysId = abpAlreadyAssigned.sys_id;&#13;
		}&#13;
		&#13;
        var aaaAlreadyAssigned = new GlideRecord('x_587457_pear_assigned_app_access');&#13;
        aaaAlreadyAssigned.addQuery('uid',pmng_user.sys_id);&#13;
        aaaAlreadyAssigned.addQuery('app_access_id',aa.sys_id);&#13;
        aaaAlreadyAssigned.addQuery('assigned_business_profile_id',abp_sysId);&#13;
        aaaAlreadyAssigned.query();&#13;
        if(!aaaAlreadyAssigned.next())&#13;
        {&#13;
			gs.info('App access NOT already assigned ' + aa.label);&#13;
			aaa.initialize();&#13;
            aaa.app_access_id = aa.sys_id;&#13;
            aaa.uid = pmng_user.sys_id;&#13;
            aaa.assignment_date = new GlideDateTime();&#13;
            aaa.assigned_project_id = aa.project_space_id;&#13;
            aaa.assigned_business_profile_id = abp_sysId;&#13;
            aaa_sysId = aaa.insert();&#13;
        }&#13;
		else&#13;
		{&#13;
			gs.info('App access already assigned ' + aa.label)&#13;
			aaa_sysId = aaa.sys_id&#13;
		}&#13;
		var apAlreadyAssigned = new GlideRecord('x_587457_pear_assigned_project_collab_space');&#13;
		apAlreadyAssigned.addQuery('uid',pmng_user.sys_id);&#13;
		apAlreadyAssigned.addQuery('project_id',p.sys_id);&#13;
		apAlreadyAssigned.query();&#13;
		if(!apAlreadyAssigned.next())&#13;
		{&#13;
			ap.initialize();&#13;
			ap.uid = pmng_user.sys_id;&#13;
			ap.project_id = p.sys_id;&#13;
			ap.assignment_date = new GlideDateTime();&#13;
			ap.assigned_app_access_id = aaa_sysId;&#13;
			ap.assigned_business_profile_id = abp_sysId;&#13;
			ap.insert();&#13;
		}&#13;
		&#13;
    }&#13;
&#13;
})(inputs, outputs);&#13;
</value>
