        <html><![CDATA[<j:jelly xmlns:j="jelly:core" xmlns:g="glide">
  <div id="pear-aa-container">
    <h4>Applicative Access (Dynamic Preview)</h4>
    <div id="pear-aa-loading">Loading data...</div>
    <table id="pear-aa-table" class="table table-bordered table-striped table-sm" style="display:none;">
      <thead>
        <tr>
          <th>Label</th>
          <th>Application</th>
          <th>Business Part</th>
          <th>Project</th>
          <th>Technical Role</th>
        </tr>
      </thead>
      <tbody id="pear-aa-body"></tbody>
    </table>
  </div>

  <script>
    // Chiamata GlideAjax per recuperare i record reali
    addLoadEvent(function() {
      var ga = new GlideAjax('x_587457_pear.PEAR_PreviewAPI');
      ga.addParam('sysparm_name', 'getApplicativeAccess');
      ga.getXMLAnswer(function(answer) {
        try {
          var data = JSON.parse(answer || '[]');
          var table = document.getElementById('pear-aa-table');
          var body = document.getElementById('pear-aa-body');
          var loading = document.getElementById('pear-aa-loading');
          loading.style.display = 'none';
          table.style.display = 'table';
          data.forEach(function(row) {
            var tr = document.createElement('tr');
            ['label','application','business_part','project','technical_role'].forEach(function(f) {
              var td = document.createElement('td');
              td.textContent = row[f] || '';
              tr.appendChild(td);
            });
            body.appendChild(tr);
          });
        } catch(e) {
          document.getElementById('pear-aa-loading').textContent = 'Error loading data';
        }
      });
    });
  </script>
</j:jelly>
