        <script><![CDATA[function onChange(control, oldValue, newValue, isLoading, isTemplate) {
   if (isLoading && newValue === '') {
      return;
   }

	var AllLabels = ['technical_role','business_unit','organization','technical_role','project','group','company'];
	for (var j = 0; j < AllLabels.length; j++) {
		var field = AllLabels[j];
		g_form.setReadOnly(field, true);
		// g_form.clearValue(field)
	}

	var ga = new GlideAjax('PEAR_Utils3');
	ga.addParam('sysparm_name', 'getApplicativeAccessFormatbyApp');
    ga.addParam('sysparm_Application', newValue);
    ga.getXMLAnswer(function(answer) {
		var i;
		var format = answer.split("|")[0];
		var separator = answer.split("|")[1];
		// g_form.addInfoMessage('answer ' + answer);
		// g_form.addInfoMessage('format ' + format);
		// g_form.addInfoMessage('separator ' + separator);
		var LabelPartArray = format.split(separator);
		var AllLabels = ['technical_role','business_unit','organization','technical_role','project','group','company'];
		var CurrentLabels = [];

		// g_form.setVisible('company',false);
		for(i=0;i<LabelPartArray.length;i++)
		{
			CurrentLabels.push(LabelPartArray[i]);
		}

		// Imposto i campi visibili / obbligatori / readonly
		for (var j = 0; j < AllLabels.length; j++) {
			var field = AllLabels[j];
			// g_form.setReadOnly(field, true);

			if (CurrentLabels.indexOf(field) !== -1) {
				// Il campo è tra quelli validi → EDITABILE + OBBLIGATORIO
				g_form.setReadOnly(field, false);
				// g_form.setMandatory(field, true);
				// g_form.setVisible(field, true);
			}
			else {
				// Il campo NON è nel formato → READONLY + NON OBBLIGATORIO
				// g_form.setReadOnly(field, true);
				g_form.setMandatory(field, false);
				g_form.clearValue(field)
				// g_form.setVisible(field, false);   // Se vuoi puoi anche metterlo a false
			}
		}



    }); 
}]]></script>
